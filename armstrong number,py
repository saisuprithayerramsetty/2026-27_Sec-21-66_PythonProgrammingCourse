number = int(input("Enter a 3-digit number: "))
original_number = number
sum = 0
while number > 0:
    digit = number % 10
    sum = sum + digit ** 3
    number = number // 10
if sum == original_number:
    print(f"{original_number} is an Armstrong number ")
else:
    print(f"{original_number} is not an Armstrong number ")